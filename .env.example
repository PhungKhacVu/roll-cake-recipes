# Example environment configuration
# Copy this file to .env and update with your values

# Application Settings
APP_NAME=Roll Cake Recipes API
APP_VERSION=1.0.0
DEBUG=False

# Data Path
DATA_PATH=./data/roll_cake_recipes_updated.csv

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security (uncomment if implementing authentication)
# SECRET_KEY=your-secret-key-here
# ACCESS_TOKEN_EXPIRE_MINUTES=30
